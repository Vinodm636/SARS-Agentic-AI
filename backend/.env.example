# ============================================================
#  SARS — Backend Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ============================================================

# ── SMS Provider ─────────────────────────────────────────────
# Choose which SMS provider sends driver dispatch notifications.
#
#   mock      — no real SMS, logs message to console (default, safe for dev/CI)
#   textbelt  — 1 free SMS/day to ANY number, zero signup, no credit card
#   textbee   — 300 free SMS/month permanently, needs Android phone as gateway
#
SMS_PROVIDER=mock

# ── Textbelt ─────────────────────────────────────────────────
# Completely free for 1 SMS/day. Just set the key to the literal word "textbelt".
# No account or signup needed.
#
# Getting started (30 seconds):
#   SMS_PROVIDER=textbelt
#   TEXTBELT_API_KEY=textbelt
#
# Test without using quota (safe for CI):
#   TEXTBELT_API_KEY=textbelt_test
#
# Need more than 1/day? Buy credits at https://textbelt.com/purchase/
#   Rates start at ~$0.009 per SMS. No subscription.
TEXTBELT_API_KEY=textbelt

# ── textbee ──────────────────────────────────────────────────
# 300 SMS/month free, permanently. Sends via your own Android SIM.
# No trial prefix. Recipients see your real mobile number as sender.
#
# Getting started (5–10 minutes):
#   1. Create a free account at https://app.textbee.dev/
#   2. Download and install the textbee APK on an Android phone
#      (phone must have an active SIM and internet connection)
#   3. Open the app and scan the QR code shown in your dashboard
#   4. In the dashboard, create an API key
#   5. Copy the API key and optionally the device ID below
#
# Free tier limits:
#   • 50 messages/day  (sent + received combined)
#   • 300 messages/month
#   • 1 Android device
#   • Upgrades start at $14.99/month for 5,000 messages
TEXTBEE_API_KEY=your_textbee_api_key_here
TEXTBEE_DEVICE_ID=                         # optional; uses first device if blank

# ── Tracking link ─────────────────────────────────────────────
# Base URL for the live-tracking link embedded in every driver SMS.
TRACKING_BASE_URL=http://localhost:3000

# ── Twilio (legacy WhatsApp feature only) ────────────────────
# Used ONLY by the existing WhatsApp notification feature.
# Not used by the SMS notification service above.
# Obtain credentials at https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_PHONE_NUMBER=+1234567890

# ── Groq API ─────────────────────────────────────────────────
# Used by the transcription service (Whisper + Llama).
# Get a key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ── CORS (production only) ───────────────────────────────────
# Comma-separated list of frontend URLs allowed to call this API.
# Leave blank for local dev (defaults to localhost:3000-3002).
# Example for production: https://sars-frontend.onrender.com
CORS_ORIGINS=

# ── Provider comparison ───────────────────────────────────────
# Provider   Free messages  Signup  Restriction               Setup time
# --------   -------------  ------  -------------------------  ----------
# mock       unlimited      none    console-only, no real SMS  0 min
# textbelt   1/day          none    none (any number)          30 sec
# textbee    300/month      yes     needs Android + SIM        5–10 min
